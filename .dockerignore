# The root package.json's dependencies (typescript, @types/*) are dev tooling,
# installed in the image's own frontend build stage; the server's come from
# backend/package.json. Patterns are relative to the build context, so this
# is the root node_modules only.
node_modules
# The image runs its own `npm install --production`; without this a local
# build's `COPY backend/ ./` would overwrite it with the host's dev install.
backend/node_modules
# Built in the image (docker/Dockerfile, stage "frontend"); a local build must
# not leave stale files in the image.
frontend/dist
# Local development only (README "Local development"): the Aspire AppHost and
# its node_modules, the dev data, and the dev seed stay out of the build
# context and the image.
aspire
.dev-data
backend/scripts
