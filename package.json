{
  "name": "listen-along",
  "private": true,
  "description": "Repo-level tooling: TypeScript typecheck and the frontend build. The server's own dependencies stay in backend/package.json.",
  "scripts": {
    "typecheck": "tsc -b",
    "build": "tsc -b frontend --force",
    "test": "npm --prefix backend test && node --test 'frontend/src/**/*.test.ts'",
    "dev": "sh scripts/dev.sh",
    "aspire:up": "sh scripts/aspire-dev.sh up",
    "aspire:down": "sh scripts/aspire-dev.sh down",
    "aspire:reset": "sh scripts/aspire-dev.sh reset"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/proxy-addr": "2.0.3",
    "@types/qrcode": "1.5.6",
    "@types/ws": "8.18.2",
    "socket.io-client": "4.8.3",
    "typescript": "7.0.2"
  }
}
