{
  // The AppHost only. Aspire runs `tsc --noEmit -p tsconfig.apphost.json`
  // before every start; the .aspire/modules SDK is generated by the CLI
  // (`aspire restore`) and gitignored. Not part of the root `tsc -b`.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": "./dist/apphost",
    "rootDir": "."
  },
  "include": [
    "apphost.mts",
    ".aspire/modules/aspire.mts",
    ".aspire/modules/base.mts",
    ".aspire/modules/transport.mts"
  ],
  "exclude": ["node_modules"]
}
