<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Parented on the framework theme so the Material Components XML library
         is not needed; all real styling happens in Compose. -->
    <style name="Theme.ListenAlong" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>
</resources>
