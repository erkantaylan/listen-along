<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Progress notification while downloading (asked for on the first download). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- WorkManager runs the download queue as a dataSync foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- The player: a mediaPlayback foreground service while it plays, and a
         wake lock so a stream keeps going with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android 8-9 only: no MediaStore RELATIVE_PATH there, so the file is
         written into the public Music folder directly. Android 10+ saves
         through MediaStore and needs no storage permission at all. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Recognising files an earlier install left in Music/ListenAlong: after a
         reinstall they no longer belong to this app. Optional, asked with a
         notice in the app; saving never needs it. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Package visibility (Android 11+): which apps can play the files. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="audio/*" />
        </intent>
    </queries>

    <!-- No backup: the index holds MediaStore URIs that mean nothing on
         another device, and the session's encryption key cannot be restored. -->
    <application
        android:name=".ListenAlongApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ListenAlong">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ListenAlong">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Sign-in: the central login sends the browser back to
             com.etaylan.listen:/oauth2redirect?code&state (the redirect
             registered for listen-along; scheme from build.gradle.kts). A path
             in a filter needs a host, which this URI has not, so the filter is
             the scheme alone and core/auth/AuthFlow checks the path and the state.
             Release builds also take the https App Link from the production
             server (src/release/AndroidManifest.xml); core/auth/AuthFlow.redirectFor
             picks one per sign-in.
             This activity only hands the URI to MainActivity and closes the
             Custom Tab. Anyone can send it a URI: a code is useless without
             the PKCE verifier, and a state that is not ours is refused. -->
        <activity
            android:name=".feature.auth.AuthRedirectActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${authRedirectScheme}" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".core.download.CancelDownloadsReceiver"
            android:exported="false" />

        <!-- The saved covers of downloaded songs as content:// URIs (not
             exported; the car's app is granted each URI it is shown). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.covers"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/cover_paths" />
        </provider>

        <!-- Exported so the system, Bluetooth and Android Auto can find the
             media session and browse the library (MediaLibraryService; the
             MediaBrowserService action is what Android Auto looks for). -->
        <service
            android:name=".core.player.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Android Auto: this is a media app. Sideloaded builds also need
             "Unknown sources" in Android Auto's developer settings. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="com.google.android.gms.car.notification.SmallIcon"
            android:resource="@drawable/ic_stat_music" />

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>

</manifest>
