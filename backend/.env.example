# Server port
PORT=3000

# Public URL of the app. Used for CORS and OAuth redirect callbacks.
# FRONTEND_URL is the CORS origin; BASE_URL is where OAuth redirects back to
# (defaults to FRONTEND_URL if unset). In production set both to your domain.
FRONTEND_URL=http://localhost:8080
# BASE_URL=http://localhost:3000

# PostgreSQL database connection (optional - runs in-memory if not set)
# DATABASE_URL=postgres://listen:listen@localhost:5432/listen

# --- Auth (Google / GitHub OAuth) -----------------------------------------
# Login is optional in dev. Set a provider's client id+secret to enable it.
# See OAUTH-SETUP.md. SESSION_SECRET signs login cookies - set a long random
# value in production.
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret
# SESSION_SECRET=change-me-to-a-long-random-string

# Dashboard authentication (optional - auto-generated if not set)
# DASHBOARD_USER=admin
# DASHBOARD_PASS=your-secure-password

# Cache directories (optional - default to /data/songs and /data/covers)
# SONGS_PATH=/data/songs
# COVERS_DIR=/data/covers

# --- yt-dlp / YouTube access -----------------------------------------------
# YouTube blocks logged-out datacenter IPs, causing "Sign in to confirm you're
# not a bot", age-restricted, and DRM/format errors on a server. Two levers:
#
# 1. Cookies (most effective): export a logged-in YouTube cookies.txt (Netscape
#    format, ideally a throwaway account) and place it at  <SONGS_PATH dir>/cookies.txt
#    i.e. /data/cookies.txt by default. yt-dlp uses it automatically when present.
# 2. Player client: switch the YouTube client yt-dlp impersonates without a code
#    change. Default 'android_vr'. Try 'web_safari,mweb', 'tv', or 'ios' if the
#    default stops working. Comma-separate for fallbacks.
# YTDLP_PLAYER_CLIENT=android_vr
#
# 3. PO Token provider: base URL of a bgutil-ytdlp-pot-provider server. This is
#    what defeats "Sign in to confirm you're not a bot" on a datacenter IP. In
#    docker-compose.prod.yml it points at the bundled bgutil-provider sidecar.
#    Leave empty to disable (local dev). Requires a PO-token-capable player
#    client such as web_safari.
# YTDLP_POT_BASE_URL=http://bgutil-provider:4416

# Note: Spotify track links are supported with NO API credentials - metadata
# is read from Spotify's public page via spotify-url-info, then matched on
# YouTube. There is nothing to configure.
