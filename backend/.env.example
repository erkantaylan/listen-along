# Server port
PORT=3000

# FRONTEND_URL is the CORS origin. BASE_URL is the public address the central
# login redirects back to (<BASE_URL>/auth/oidc/callback); defaults to
# FRONTEND_URL. One of the two is required with central login.
FRONTEND_URL=http://localhost:8080
# BASE_URL=http://localhost:3000

# PostgreSQL database connection (optional - runs in-memory if not set)
# DATABASE_URL=postgres://listen:listen@localhost:5432/listen

# --- Sign-in -------------------------------------------------------------------
# One of the two must be on, or the server refuses to start.
#
# Central login (OIDC, see CENTRAL-LOGIN.md): the only sign-in in production,
# required there. For a local IdP: `node src/fakeOidcIssuer.js` prints these.
# OIDC_ISSUER=https://id.example.com/application/o/listen-along/
# OIDC_CLIENT_ID=listen-along
#
# Dev sign-in, local development and tests ONLY: /auth/dev/login signs anyone
# in as anyone, no password. Refused unless NODE_ENV is development or test.
# NODE_ENV=development
# INSECURE_DEV_LOGIN=1
#
# SESSION_SECRET encrypts the central login's stored tokens and signs the dev
# cookie. Required in production; a long random value.
# SESSION_SECRET=change-me-to-a-long-random-string

# Cache directories (optional - default to /data/songs and /data/covers)
# SONGS_PATH=/data/songs
# COVERS_DIR=/data/covers

# --- Music library / CLI uploads ---------------------------------------------
# The server does NOT download from YouTube. Songs are uploaded as m4a by the
# listen-along CLI (cli/), authenticated with tokens from each user's profile page.
#
# Login for the /dashboard page (server stats, user approval, playlists, CLI
# tokens, downloaders, jobs, requests, library songs).
# ADMIN_USER defaults to "admin". Leave ADMIN_PASSWORD unset to disable it.
# ADMIN_USER=admin
# ADMIN_PASSWORD=change-me
#
# yt-dlp is still used, but only for metadata: YouTube search and playlist
# listing (both --flat-playlist, no audio, no PO token). If YouTube blocks even
# that, queueing by search text falls back to a library text search and users
# can always pick songs from the Library page.

# Note: Spotify track links are supported with NO API credentials - metadata
# is read from Spotify's public page via spotify-url-info, then matched
# against the library (or turned into a song request). There is nothing to configure.
