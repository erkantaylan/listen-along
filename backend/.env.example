# Server port
PORT=3000

# Public URL of the app. Used for CORS and OAuth redirect callbacks.
# FRONTEND_URL is the CORS origin; BASE_URL is where OAuth redirects back to
# (defaults to FRONTEND_URL if unset). In production set both to your domain.
FRONTEND_URL=http://localhost:8080
# BASE_URL=http://localhost:3000

# PostgreSQL database connection (optional - runs in-memory if not set)
# DATABASE_URL=postgres://listen:listen@localhost:5432/listen

# --- Auth (Google / GitHub OAuth) -----------------------------------------
# Login is optional in dev. Set a provider's client id+secret to enable it.
# See OAUTH-SETUP.md. SESSION_SECRET signs login cookies - set a long random
# value in production.
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret
# SESSION_SECRET=change-me-to-a-long-random-string

# Dashboard authentication (optional - auto-generated if not set)
# DASHBOARD_USER=admin
# DASHBOARD_PASS=your-secure-password

# Cache directories (optional - default to /data/songs and /data/covers)
# SONGS_PATH=/data/songs
# COVERS_DIR=/data/covers

# Note: Spotify track links are supported with NO API credentials - metadata
# is read from Spotify's public page via spotify-url-info, then matched on
# YouTube. There is nothing to configure.
