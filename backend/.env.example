# Server port
PORT=3000

# Public URL of the app. Used for CORS and OAuth redirect callbacks.
# FRONTEND_URL is the CORS origin; BASE_URL is where OAuth redirects back to
# (defaults to FRONTEND_URL if unset). In production set both to your domain.
FRONTEND_URL=http://localhost:8080
# BASE_URL=http://localhost:3000

# PostgreSQL database connection (optional - runs in-memory if not set)
# DATABASE_URL=postgres://listen:listen@localhost:5432/listen

# --- Auth (Google / GitHub OAuth) -----------------------------------------
# Login is optional in dev. Set a provider's client id+secret to enable it.
# See OAUTH-SETUP.md. SESSION_SECRET signs login cookies - set a long random
# value in production.
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret
# SESSION_SECRET=change-me-to-a-long-random-string

# Cache directories (optional - default to /data/songs and /data/covers)
# SONGS_PATH=/data/songs
# COVERS_DIR=/data/covers

# --- Music library / CLI uploads ---------------------------------------------
# The server does NOT download from YouTube. Songs are uploaded as m4a by the
# listen-along CLI (cli/), authenticated with tokens created on /admin.
#
# Login for the /admin page (create/revoke CLI tokens, manage requests and
# library songs) and the /dashboard page (server stats, user approval, lobbies).
# ADMIN_USER defaults to "admin". Leave ADMIN_PASSWORD unset to disable both.
# ADMIN_USER=admin
# ADMIN_PASSWORD=change-me
#
# yt-dlp is still used, but only for metadata: YouTube search and playlist
# listing (both --flat-playlist, no audio, no PO token). If YouTube blocks even
# that, queueing by search text falls back to a library text search and users
# can always pick songs from the Library page.

# Note: Spotify track links are supported with NO API credentials - metadata
# is read from Spotify's public page via spotify-url-info, then matched
# against the library (or turned into a song request). There is nothing to configure.
