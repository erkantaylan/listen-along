{
  // The server runs its .ts files directly (Node's type stripping), so this
  // only typechecks. The few .js files (the old telemetry.js path, the dev
  // seed) are part of the program but not checked.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["node"],
    // ES modules as Node runs them ("type": "module" in package.json).
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "tsBuildInfoFile": "../node_modules/.cache/tsbuildinfo/backend.tsbuildinfo"
  },
  "include": ["src/**/*"]
}
